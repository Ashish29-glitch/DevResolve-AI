# ============================================
# DevResolve AI - Environment Configuration
# ============================================

# Application
SECRET_KEY=your-super-secret-key-change-this-in-production
APP_URL=http://localhost:8000

# Database
DATABASE_PATH=data/devresolve.db
DATABASE_URL=sqlite:///./data/devresolve.db

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email (OTP via Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@devresolve.ai

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Embeddings
GOOGLE_API_KEY=your-google-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=google
EMBEDDING_DIMENSION=768

# Qdrant Vector DB
QDRANT_URL=your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=devresolve_docs

# Self-RAG Controls
TOP_K=5
MAX_SUPPORT_RETRIES=2
MAX_RETRIEVAL_REWRITES=2
MAX_WEB_REWRITES=2

# OTP
OTP_EXPIRE_MINUTES=10
